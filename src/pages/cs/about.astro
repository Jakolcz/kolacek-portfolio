---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const techStack = {
  languages: [
    { name: 'Java (8-21)', icon: 'coffee' },
    { name: 'SQL', icon: 'database' },
    { name: 'Python', icon: 'terminal' }
  ],
  frameworks: [
    { name: 'Spring Boot', icon: 'deployed_code' },
    { name: 'Spring Security', icon: 'security' },
    { name: 'Hibernate', icon: 'table_rows' },
    { name: 'Liquibase', icon: 'history' }
  ],
  infrastructure: [
    { name: 'Docker & K8s', icon: 'container' },
    { name: 'Jenkins', icon: 'build' },
    { name: 'Linux', icon: 'terminal' }
  ],
  databases: [
    { name: 'PostgreSQL', icon: 'storage' },
    { name: 'Oracle', icon: 'database' },
    { name: 'Elasticsearch', icon: 'search' }
  ]
};
---

<BaseLayout title={t('nav.about') + " | Jakub Koláček"}>
  <Navbar />

  <main class="pt-24 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <PageHeader
      badge={t('about.badge')}
      title={t('about.title')}
      description={t('about.description')}
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Left Column -->
      <div class="col-span-1 lg:col-span-2 flex flex-col gap-6">

        <!-- The Journey Card -->
        <div class="relative bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-10 overflow-hidden group hover:border-primary/50 transition-colors">
          <div class="absolute top-0 right-0 p-10 opacity-5 dark:opacity-10 group-hover:opacity-10 dark:group-hover:opacity-20 transition-opacity pointer-events-none">
            <span class="material-symbols-outlined text-[12rem] text-primary rotate-12">route</span>
          </div>

          <div class="relative z-10">
            <div class="flex items-center gap-3 mb-6">
              <span class="material-symbols-outlined text-primary text-3xl">person</span>
              <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-mono">{t('about.journey.title')}</h2>
            </div>

            <div class="space-y-4 text-zinc-600 dark:text-zinc-400 leading-relaxed text-lg">
              <p set:html={t('about.journey.p1')} />
              <p set:html={t('about.journey.p2')} />
              <p set:html={t('about.journey.p3')} />
            </div>

            <div class="flex flex-wrap gap-3 mt-8">
              <span class="px-3 py-1 rounded-full bg-zinc-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-300 text-sm font-mono flex items-center gap-2 border border-zinc-300 dark:border-zinc-700">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                {t('about.journey.tag1')}
              </span>
              <span class="px-3 py-1 rounded-full bg-zinc-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-300 text-sm font-mono flex items-center gap-2 border border-zinc-300 dark:border-zinc-700">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                {t('about.journey.tag2')}
              </span>
              <span class="px-3 py-1 rounded-full bg-zinc-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-300 text-sm font-mono flex items-center gap-2 border border-zinc-300 dark:border-zinc-700">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                {t('about.journey.tag3')}
              </span>
            </div>
          </div>
        </div>

        <!-- Bottom Grid: Hobbies & Languages -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <!-- When I'm not coding -->
          <div class="relative bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8 overflow-hidden group hover:border-primary/50 transition-colors flex flex-col justify-between h-full">
            <div class="absolute top-4 right-4 opacity-5 dark:opacity-10 group-hover:opacity-10 dark:group-hover:opacity-20 transition-opacity pointer-events-none">
              <span class="material-symbols-outlined text-8xl text-primary">memory</span>
            </div>

            <div class="relative z-10">
              <h3 class="text-xl font-bold text-slate-900 dark:text-white font-mono mb-4">{t('about.hobbies.title')}</h3>
              <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed" set:html={t('about.hobbies.text')} />
            </div>

            <div class="flex gap-4 mt-6 text-primary">
              <span class="material-symbols-outlined text-3xl">smart_toy</span>
              <span class="material-symbols-outlined text-3xl">developer_board</span>
            </div>
          </div>

          <!-- Languages -->
          <div class="relative bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8 overflow-hidden group hover:border-primary/50 transition-colors flex flex-col justify-between h-full">
            <div class="absolute top-4 right-4 opacity-5 dark:opacity-10 group-hover:opacity-10 dark:group-hover:opacity-20 transition-opacity pointer-events-none">
              <span class="material-symbols-outlined text-8xl text-primary">translate</span>
            </div>

            <div class="relative z-10">
              <h3 class="text-xl font-bold text-slate-900 dark:text-white font-mono mb-6">{t('about.languages.title')}</h3>

              <div class="space-y-4">
                <div class="flex justify-between items-center border-b border-zinc-200 dark:border-zinc-800 pb-2">
                  <span class="text-slate-900 dark:text-zinc-300 font-medium">{t('about.languages.cs')}</span>
                  <span class="px-2 py-1 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 text-xs rounded border border-emerald-200 dark:border-emerald-800/50 font-mono">
                    {t('about.languages.cs_level')}
                  </span>
                </div>
                <div class="flex justify-between items-center border-b border-zinc-200 dark:border-zinc-800 pb-2">
                  <span class="text-slate-900 dark:text-zinc-300 font-medium">{t('about.languages.en')}</span>
                  <span class="px-2 py-1 bg-zinc-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-300 text-xs rounded border border-zinc-300 dark:border-zinc-700 font-mono">
                    {t('about.languages.en_level')}
                  </span>
                </div>
              </div>
            </div>

            <p class="text-zinc-500 text-sm mt-6 pt-4 border-t border-zinc-200 dark:border-zinc-800 italic">
              {t('about.languages.note')}
            </p>
          </div>

        </div>
      </div>

      <!-- Right Column: Tech Stack -->
      <div class="col-span-1 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8 hover:border-primary/50 transition-colors h-full flex flex-col">
        <div class="flex items-center gap-3 mb-8">
          <span class="material-symbols-outlined text-primary text-2xl">terminal</span>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white font-mono">{t('about.stack.title')}</h2>
        </div>

        <div class="space-y-8 flex-1">
          <!-- Languages -->
          <div>
            <h3 class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-4 pb-2 border-b border-zinc-200 dark:border-zinc-800">{t('about.stack.languages')}</h3>
            <ul class="space-y-2">
              {techStack.languages.map((item) => (
                <li class="flex items-center gap-2 text-slate-900 dark:text-zinc-300 hover:text-primary dark:hover:text-primary transition-colors group/item">
                  <span class="text-emerald-600 dark:text-primary text-xs font-mono group-hover/item:translate-x-1 transition-transform">&gt;</span>
                  <span class="font-mono text-sm">{item.name}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Frameworks -->
          <div>
            <h3 class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-4 pb-2 border-b border-zinc-200 dark:border-zinc-800">{t('about.stack.frameworks')}</h3>
            <ul class="space-y-2">
              {techStack.frameworks.map((item) => (
                <li class="flex items-center gap-2 text-slate-900 dark:text-zinc-300 hover:text-primary dark:hover:text-primary transition-colors group/item">
                  <span class="text-emerald-600 dark:text-primary text-xs font-mono group-hover/item:translate-x-1 transition-transform">&gt;</span>
                  <span class="font-mono text-sm">{item.name}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Infrastructure -->
          <div>
            <h3 class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-4 pb-2 border-b border-zinc-200 dark:border-zinc-800">{t('about.stack.infrastructure')}</h3>
            <ul class="space-y-2">
              {techStack.infrastructure.map((item) => (
                <li class="flex items-center gap-2 text-slate-900 dark:text-zinc-300 hover:text-primary dark:hover:text-primary transition-colors group/item">
                  <span class="text-emerald-600 dark:text-primary text-xs font-mono group-hover/item:translate-x-1 transition-transform">&gt;</span>
                  <span class="font-mono text-sm">{item.name}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Databases -->
          <div>
            <h3 class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-4 pb-2 border-b border-zinc-200 dark:border-zinc-800">{t('about.stack.databases')}</h3>
            <ul class="space-y-2">
              {techStack.databases.map((item) => (
                <li class="flex items-center gap-2 text-slate-900 dark:text-zinc-300 hover:text-primary dark:hover:text-primary transition-colors group/item">
                  <span class="text-emerald-600 dark:text-primary text-xs font-mono group-hover/item:translate-x-1 transition-transform">&gt;</span>
                  <span class="font-mono text-sm">{item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-zinc-200 dark:border-zinc-800 relative overflow-hidden group/box">
           <div class="absolute inset-0 bg-zinc-200/50 dark:bg-zinc-800/30 translate-y-full group-hover/box:translate-y-0 transition-transform duration-500"></div>
           <div class="relative z-10 flex items-center justify-center">
             <span class="material-symbols-outlined text-6xl text-zinc-300 dark:text-zinc-700 group-hover/box:text-primary transition-colors duration-500">layers</span>
           </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
