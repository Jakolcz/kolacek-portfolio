---
import PageHeader from './PageHeader.astro';
import { useTranslations } from '../i18n/utils';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const jobs = [
  {
    role: t('resume.job1.role'),
    company: t('resume.job1.company'),
    date: t('resume.job1.date'),
    companyInitial: 'I',
    tags: ['Java 8-25', 'Spring Boot', 'Kubernetes', 'Docker', 'Elasticsearch'],
    bullets: [
      t('resume.job1.bullet1'),
      t('resume.job1.bullet2'),
      t('resume.job1.bullet3'),
      t('resume.job1.bullet4'),
      t('resume.job1.bullet5'),
    ]
  },
  {
    role: t('resume.job2.role'),
    company: t('resume.job2.company'),
    date: t('resume.job2.date'),
    companyInitial: 'H',
    tags: ['Java 7', 'Adobe CQ5', 'SAP JCO', 'MSSQL'],
    bullets: [
      t('resume.job2.bullet1'),
      t('resume.job2.bullet2'),
    ]
  },
  {
    role: t('resume.job3.role'),
    company: t('resume.job3.company'),
    date: t('resume.job3.date'),
    companyInitial: 'A',
    tags: ['Android SDK', 'Java', 'WebServices'],
    bullets: [
      t('resume.job3.bullet1'),
      t('resume.job3.bullet2'),
    ]
  }
];

const skills = {
  backend: {
    title: t('resume.sidebar.tech.backend'),
    level: t('resume.sidebar.tech.backend_level'),
    tags: ['Java (8-25)', 'Spring Boot', 'Hibernate', 'Liquibase', 'Thymeleaf']
  },
  infrastructure: {
    title: t('resume.sidebar.tech.infrastructure'),
    tags: ['Docker', 'Kubernetes', 'Jenkins', 'Maven', 'Linux']
  },
  data: {
    title: t('resume.sidebar.tech.data'),
    tags: ['PostgreSQL', 'Oracle DB', 'Elasticsearch']
  }
};
---

<main class="pt-24 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <PageHeader
      badge={t('resume.badge')}
      title={t('resume.title')}
      subtitle={t('resume.subtitle')}
      description={t('resume.description')}
    >
      <div slot="actions" class="flex gap-3">
        <button class="flex items-center gap-2 px-4 py-2 rounded-lg bg-zinc-200 dark:bg-zinc-800 text-slate-900 dark:text-white font-medium hover:bg-zinc-300 dark:hover:bg-zinc-700 transition-colors cursor-default">
            <span class="material-symbols-outlined text-xl">share</span>
            {t('resume.actions.share')}
        </button>
         <a href="#" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-white font-medium hover:bg-emerald-600 transition-colors shadow-lg shadow-primary/20">
            <span class="material-symbols-outlined text-xl">download</span>
            {t('resume.actions.download')}
        </a>
      </div>
    </PageHeader>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column: Experience -->
        <div class="lg:col-span-2 space-y-8">
            <div class="flex items-center gap-3 mb-6">
                 <span class="material-symbols-outlined text-primary text-3xl">work_history</span>
                 <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-mono uppercase tracking-wide">{t('resume.experience.title')}</h2>
            </div>

            <div class="space-y-6">
                {jobs.map((job) => (
                    <div class="bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8 hover:border-primary/50 hover:translate-y-[-2px] transition-all group">
                        <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6">
                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 rounded-xl bg-white dark:bg-zinc-800 flex items-center justify-center shrink-0 border border-zinc-200 dark:border-zinc-700">
                                     <span class="font-bold text-lg text-slate-900 dark:text-white">{job.companyInitial}</span>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-slate-900 dark:text-white font-mono">{job.role}</h3>
                                    <div class="text-primary font-medium">{job.company}</div>
                                </div>
                            </div>
                            <span class="px-3 py-1 rounded-full bg-zinc-200 dark:bg-zinc-800 text-xs font-mono text-zinc-600 dark:text-zinc-400 border border-zinc-300 dark:border-zinc-700 self-start md:self-center whitespace-nowrap">
                                {job.date}
                            </span>
                        </div>

                        <div class="flex flex-wrap gap-2 mb-6">
                            {job.tags.map(tag => (
                                <span class="px-2 py-1 rounded bg-zinc-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-300 text-xs font-mono border border-zinc-300 dark:border-zinc-700">
                                    {tag}
                                </span>
                            ))}
                        </div>

                        <ul class="space-y-2">
                            {job.bullets.map(bullet => (
                                <li class="flex items-start gap-3 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                                    <span class="mt-2 w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                                    <span>{bullet}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>

        <!-- Right Column: Sidebar -->
        <div class="lg:col-span-1 space-y-8">

            <!-- Technical Arsenal -->
            <div class="bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8">
                <h3 class="text-sm font-mono text-zinc-500 uppercase tracking-wider mb-6 pb-2 border-b border-zinc-200 dark:border-zinc-800">
                    {t('resume.sidebar.tech.title')}
                </h3>

                <div class="space-y-6">
                    <!-- Backend -->
                    <div>
                        <div class="flex justify-between items-center mb-3">
                             <h4 class="font-bold text-slate-900 dark:text-white">{skills.backend.title}</h4>
                             {skills.backend.level && <span class="text-xs font-mono text-emerald-600 dark:text-primary">{skills.backend.level}</span>}
                        </div>
                        <div class="flex flex-wrap gap-2">
                            {skills.backend.tags.map(tag => (
                                <span class="px-2 py-1 rounded bg-zinc-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-300 text-xs font-mono border border-zinc-300 dark:border-zinc-700">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    </div>

                     <!-- Infrastructure -->
                    <div>
                        <h4 class="font-bold text-slate-900 dark:text-white mb-3">{skills.infrastructure.title}</h4>
                        <div class="flex flex-wrap gap-2">
                            {skills.infrastructure.tags.map(tag => (
                                <span class="px-2 py-1 rounded bg-zinc-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-300 text-xs font-mono border border-zinc-300 dark:border-zinc-700">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    </div>

                     <!-- Data -->
                    <div>
                        <h4 class="font-bold text-slate-900 dark:text-white mb-3">{skills.data.title}</h4>
                        <div class="flex flex-wrap gap-2">
                            {skills.data.tags.map(tag => (
                                <span class="px-2 py-1 rounded bg-zinc-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-300 text-xs font-mono border border-zinc-300 dark:border-zinc-700">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Education -->
            <div class="bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 md:p-8">
                <h3 class="text-sm font-mono text-zinc-500 uppercase tracking-wider mb-6 pb-2 border-b border-zinc-200 dark:border-zinc-800">
                    {t('resume.sidebar.education.title')}
                </h3>

                <div class="relative pl-6 border-l border-zinc-300 dark:border-zinc-700 space-y-8">
                    <div class="relative">
                         <span class="absolute -left-[29px] top-1.5 w-3 h-3 rounded-full bg-emerald-500 border-2 border-zinc-100 dark:border-zinc-900"></span>
                         <h4 class="font-bold text-slate-900 dark:text-white leading-tight">{t('resume.sidebar.education.degree')}</h4>
                         <div class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">{t('resume.sidebar.education.school')}</div>
                         <div class="text-xs font-mono text-primary mt-2">{t('resume.sidebar.education.date')}</div>
                    </div>
                </div>
            </div>

            <!-- Let's Connect -->
             <div class="bg-emerald-900/10 border border-emerald-500/20 rounded-2xl p-6 md:p-8">
                <h3 class="text-sm font-mono text-emerald-600 dark:text-primary uppercase tracking-wider mb-4">
                    {t('resume.sidebar.connect.title')}
                </h3>
                <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mb-6">
                    {t('resume.sidebar.connect.text')}
                </p>
                <div class="flex gap-2">
                    <a href="mailto:jakub@example.com" class="w-10 h-10 rounded bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center text-slate-900 dark:text-white hover:bg-primary hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-lg">mail</span>
                    </a>
                     <a href="#" class="w-10 h-10 rounded bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center text-slate-900 dark:text-white hover:bg-primary hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-lg">link</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</main>
